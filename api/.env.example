APP_ENV=development
API_V1_PREFIX=/api/v1
# Docker Compose: usa host `postgres` (DNS interno del compose).
# Ejecucion host sin Docker: cambia a `localhost` en DATABASE_URL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/deudamundi
SUPABASE_DATABASE_URL=
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_ORIGIN_REGEX=
RATE_LIMIT_REQUESTS_PER_MINUTE=100
SECURITY_HSTS_ENABLED=false
ADMIN_API_KEY=
ETL_SCHEDULER_ENABLED=false
ETL_SCHEDULE_CRON=0 2 1 2 *
ETL_ALLOW_PROXY_DEBT_FALLBACK=false
ETL_SEED_GOVERNMENTS_ENABLED=true
ETL_GOVERNMENTS_SOURCE=hybrid
ETL_GOVERNMENTS_MIN_START_YEAR=1990
ETL_GOVERNMENTS_TIMEOUT_SECONDS=30
ETL_GOVERNMENTS_CHUNK_SIZE=25
ETL_GOVERNMENTS_MAX_DURATION_SECONDS=180
RUN_MIGRATIONS=true
