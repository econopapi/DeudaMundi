# Dominio público que ya apunta a la IP del VPS. Caddy emitirá y renovará TLS.
DOMAIN=deudamundi.example.com

# Base de datos local (no se expone fuera de Docker).
POSTGRES_DB=deudamundi
POSTGRES_USER=deudamundi
POSTGRES_PASSWORD=replace-with-a-long-random-password

# API
APP_ENV=production
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=https://deudamundi.example.com
CORS_ALLOW_ORIGIN_REGEX=
RATE_LIMIT_REQUESTS_PER_MINUTE=100
SECURITY_HSTS_ENABLED=true
ADMIN_API_KEY=replace-with-a-long-random-api-key
RUN_MIGRATIONS=true

# ETL
ETL_SCHEDULER_ENABLED=false
ETL_SCHEDULE_CRON=0 2 1 2 *
ETL_ENABLE_QEDS_EXTERNAL_DEBT=true
ETL_ALLOW_PROXY_DEBT_FALLBACK=false
ETL_SEED_GOVERNMENTS_ENABLED=true
ETL_GOVERNMENTS_SOURCE=hybrid
ETL_GOVERNMENTS_MIN_START_YEAR=1990
ETL_GOVERNMENTS_TIMEOUT_SECONDS=30
ETL_GOVERNMENTS_CHUNK_SIZE=25
ETL_GOVERNMENTS_MAX_DURATION_SECONDS=180
